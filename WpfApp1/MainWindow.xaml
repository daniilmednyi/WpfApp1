<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <WrapPanel Margin="10" Orientation="Vertical">
        <Label Content="Анкета:" Margin="5" FontWeight="Bold" />
        <Label Content="Ваше имя:" Margin="5" />
        <TextBox x:Name="txtName" Width="200" Margin="5"/>
        <Label Content="Ваш возрвраст:" Margin="5"/>
        <TextBox x:Name="txtAge" Width="200" Margin="5"/>
        <Label Content="Пол" Margin="5"/>
        <WrapPanel Margin="5">
            <RadioButton x:Name="genderman" Content="Мужской" Margin="15"/>
            <RadioButton x:Name="gendergirl" Content="Женский" Margin="15"/>
        </WrapPanel>
        <WrapPanel Margin="5">
            <Label Content="Интенсивы" Margin="17" FontWeight="Bold"/>
            <CheckBox x:Name="sport" Content="Спорт" Margin="15"/>
            <CheckBox x:Name="musiс" Content="Музыка" Margin="15" />
            <CheckBox x:Name="coding" Content="Программирование" Margin="15"/>
        </WrapPanel>
        <Button Content="Отправить" Margin="5" Click="Reg_Click"/>
    </WrapPanel>
</Window>
